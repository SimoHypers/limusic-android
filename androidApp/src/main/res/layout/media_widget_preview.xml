<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows: the strip in the default dark theme. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_shape"
    android:backgroundTint="#FF161116"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/widget_preview_shape"
        android:backgroundTint="#FF262126"
        android:contentDescription="@null"
        android:padding="12dp"
        android:src="@drawable/mono"
        android:tint="#FFA89EA8" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_name"
            android:textColor="#FFFAFAFA"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_description"
            android:textColor="#FFA89EA8"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:padding="9dp"
        android:src="@drawable/rounded_skip_previous_24"
        android:tint="#FFFAFAFA" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_preview_shape"
        android:backgroundTint="#FFFF2056"
        android:contentDescription="@null"
        android:padding="9dp"
        android:src="@drawable/rounded_play_arrow_24"
        android:tint="#FFFFFFFF" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:padding="9dp"
        android:src="@drawable/rounded_skip_next_24"
        android:tint="#FFFAFAFA" />
</LinearLayout>
